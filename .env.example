# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed.

APP_NAME=TokenFuse
ENVIRONMENT=development
LOG_LEVEL=INFO

# Neon / Supabase Postgres (asyncpg driver is added in a later phase)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/tokenfuse
# Upstash Redis
REDIS_URL=redis://localhost:6379/0

# Provider API keys (the keys WE hold, not the per-project keys we issue)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROK_API_KEY=

# Burn-rate alert delivery
TELEGRAM_BOT_TOKEN=
ALERT_WEBHOOK_URL=

# Budget defaults (per-project values will override these later)
DEFAULT_MONTHLY_BUDGET_USD=50
BUDGET_WARN_PCT=0.8
BUDGET_WINDOW_SECONDS=3600
FALLBACK_MODEL=